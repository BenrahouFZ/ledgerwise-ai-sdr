# Copy this file to a new file named .env  (same folder), then paste your key.
# FREE option (no credit card): get a key at https://aistudio.google.com/app/apikey
PROVIDER=gemini
GEMINI_API_KEY=paste-your-key-here

# Other free option: https://console.groq.com/keys  (set PROVIDER=groq)
GROQ_API_KEY=paste-your-key-here

# Paid option (set PROVIDER=anthropic)
ANTHROPIC_API_KEY=paste-your-key-here

# Optional: force a model name, otherwise a good default is used
# MODEL=gemini-2.5-flash
