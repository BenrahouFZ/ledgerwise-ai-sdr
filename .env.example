# Copy to .env and fill in. Never commit .env.
PROVIDER=gemini
GEMINI_API_KEY=paste-your-key-here
MODEL=gemini-3.1-flash-lite

SUPABASE_URL=paste-your-project-url
SUPABASE_KEY=paste-your-secret-key

TAVILY_API_KEY=paste-your-key-here

CALCOM_API_KEY=paste-your-key-here
CALCOM_EVENT_TYPE_ID=paste-the-event-type-number

# Bookings use a plus-address of this email (no real prospect is ever emailed)
DEMO_EMAIL=you@example.com

# Optional: if set, the whole app asks for this password (use it on the live site)
APP_PASSWORD=
